# AkibaFlow environment — placeholders only. Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | production (production disables the sandbox simulator)
APP_URL=http://localhost:8080
APP_KEY=change-me-to-64-random-hex-chars
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_CURRENCY=KES

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=akibaflow
DB_USER=akiba
DB_PASS=change-me

# Payments: sandbox (built-in simulator, dev only) | mpesa
PAYMENT_DRIVER=sandbox
MPESA_ENV=sandbox              # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TXN_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till
MPESA_CALLBACK_SECRET=change-me-long-random   # path secret in callback URLs
MPESA_CALLBACK_IP_ALLOWLIST=   # optional comma list of Safaricom source IPs
MPESA_VERIFY_WITH_QUERY=true   # independently confirm via STK Query before crediting

# Notifications
MAIL_DRIVER=log                # log | mail
MAIL_FROM=no-reply@akibaflow.example
SMS_DRIVER=none                # none | africastalking
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
