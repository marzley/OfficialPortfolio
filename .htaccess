# Apache / cPanel settings for https://marzleytechsolutions.co.ke
# Needs an active SSL certificate (cPanel > SSL/TLS Status > Run AutoSSL)
# before the HTTPS redirect below is switched on.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /index.html

# ---------- One canonical address: https, no "www" ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://marzleytechsolutions.co.ke%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.marzleytechsolutions\.co\.ke$ [NC]
    RewriteRule ^ https://marzleytechsolutions.co.ke%{REQUEST_URI} [L,R=301]

    # /index.html -> / so search engines see one homepage
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [L,R=301]

    # The site is one page now; send old page addresses (still in Google and
    # old links) to the matching section of the homepage
    RewriteRule ^about\.html$ /#about [NE,L,R=301]
    RewriteRule ^service\.html$ /#services [NE,L,R=301]
    RewriteRule ^booking\.html$ /#pricing [NE,L,R=301]
    RewriteRule ^testimonial\.html$ /#testimonials [NE,L,R=301]
    RewriteRule ^contact\.html$ /#contact [NE,L,R=301]
    RewriteRule ^(marzley|training|404)\.html$ / [L,R=301]
</IfModule>

# ---------- Keep private files private ----------
<FilesMatch "\.(log|md|scss|ini|sh|bak|sql|exe)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(\.git.*|\.env.*|mpesa-config.*\.php)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# ---------- Security headers ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---------- File types ----------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType application/vnd.android.package-archive .apk
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
