# Apache / cPanel settings for https://marzleytechsolutions.co.ke
# Needs an active SSL certificate (cPanel > SSL/TLS Status > Run AutoSSL)
# before the HTTPS redirect below is switched on.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---------- One canonical address: https, no "www" ----------
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://marzleytechsolutions.co.ke%{REQUEST_URI} [L,R=301]

    RewriteCond %{HTTP_HOST} ^www\.marzleytechsolutions\.co\.ke$ [NC]
    RewriteRule ^ https://marzleytechsolutions.co.ke%{REQUEST_URI} [L,R=301]

    # /index.html -> / so search engines see one homepage
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [L,R=301]

    # Clean page addresses: /about serves about.html, and about.html or
    # /about/ redirect to /about so each page has one address
    RewriteCond %{THE_REQUEST} \s/([a-z0-9-]+)\.html[\s?] [NC]
    RewriteCond %1 !^(index|offline|404)$
    RewriteRule ^ /%1 [L,R=301]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([a-z0-9-]+)/$ /$1 [L,R=301]
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^([a-z0-9-]+)$ $1.html [END]

    # Old page addresses (still in Google and old links)
    RewriteRule ^service(\.html|/)?$ /services [L,R=301]
    RewriteRule ^booking(\.html|/)?$ /pricing [L,R=301]
    RewriteRule ^testimonial(\.html|/)?$ /work#testimonials [NE,L,R=301]
    RewriteRule ^marzley(\.html|/)?$ / [L,R=301]
</IfModule>

# ---------- Keep private files private ----------
RedirectMatch 404 ^/(content|tools)/
<FilesMatch "\.(log|md|scss|ini|sh|bak|sql|exe|py)$">
    Require all denied
</FilesMatch>
# Private folders: PHP libraries, tests and CI settings are never served
RedirectMatch 404 ^/(phpvendor|tests|\.github)(/|$)

<FilesMatch "^(\.git.*|\.env.*|(mpesa|portal)-config.*\.php|composer\.(json|lock))$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git

# ---------- Security headers ----------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Which scripts, frames and connections pages may use (see DEPLOY.md before adding a new service)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://js.paystack.co https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://formspree.io https://accounts.google.com/gsi/ https://*.paystack.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src 'self' https://accounts.google.com/gsi/ https://*.paystack.com https://*.paystack.co https://www.youtube-nocookie.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>

# ---------- File types ----------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType application/vnd.android.package-archive .apk
    AddType application/wasm .wasm
    AddType text/javascript .mjs
</IfModule>

# ---------- Service worker: always check for a new version ----------
<Files "sw.js">
    <IfModule mod_expires.c>
        ExpiresActive Off
    </IfModule>
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, must-revalidate"
    </IfModule>
</Files>

# ---------- Compression ----------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>

# ---------- Browser caching ----------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>
